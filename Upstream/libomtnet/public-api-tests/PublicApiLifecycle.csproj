<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireUpstream" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(OMTUpstreamRoot)' == ''" Text="Set OMTUpstreamRoot to a pristine libomtnet checkout." />
  </Target>
  <ItemGroup Condition="'$(OMTUpstreamRoot)' != ''">
    <ProjectReference Include="$(OMTUpstreamRoot)/libomtnet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="direct-video-restart/**/*.cs" />
  </ItemGroup>
</Project>
